{
  "id": "./",
  "name": "Hub",
  "short_name": "Hub",
  "description": "A local-first browser launchpad for links, tasks, and scratchpad notes.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#faf7f2",
  "theme_color": "#faf7f2",
  "categories": ["productivity", "utilities"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "note_taking": {
    "new_note_url": "./?action=new-note"
  },
  "file_handlers": [
    {
      "action": "./?action=import",
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-monochrome.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot-narrow.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Hub launchpad on a phone"
    },
    {
      "src": "./screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Hub launchpad on a desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "New Bookmark",
      "short_name": "Bookmark",
      "description": "Add a new bookmark to Hub",
      "url": "./?action=new-bookmark",
      "icons": [{ "src": "./shortcut-bookmark.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "New Task",
      "short_name": "Task",
      "description": "Create a new task",
      "url": "./?action=new-task",
      "icons": [{ "src": "./shortcut-task.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "New Note",
      "short_name": "Note",
      "description": "Create a new scratchpad note",
      "url": "./?action=new-note",
      "icons": [{ "src": "./shortcut-note.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
